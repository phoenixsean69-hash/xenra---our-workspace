{
  "name": "xenra",
  "productName": "XENRA",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron . --production",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.5",
    "typescript": "^5.9.0",
    "vite": "8.3.1",
    "wait-on": "9.1.0"
  }
}
